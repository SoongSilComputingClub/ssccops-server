# docker-compose용 환경변수 예시 파일
# 실제 값을 채운 뒤 .env 로 복사해서 사용하세요 (.env 는 git에 커밋되지 않습니다)
#   cp .env.example .env

### PostgreSQL / Database ###
DB_NAME=ssccops_server_db
DB_USER=dba
DB_USERNAME=dba
DB_PASSWORD=changeme
# 로컬에서 직접 Supabase/PostgreSQL 연결 시 사용 (예: jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres)
DB_URL=jdbc:postgresql://localhost:5432/ssccops_server_db

### Supabase Auth (local 전용 — dev/prod는 배포 환경에 별도로 주입되어 있음) ###
# JWT 검증용 JWKS가 이 URL 기준 /auth/v1/.well-known/jwks.json 에서 조회된다
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

### Frontend ###
# CORS 허용 오리진. 쉼표로 여러 개를 넣을 수 있다 (예: http://localhost:4000,http://localhost:3000)
FRONTEND_URL=http://localhost:4000
PROD_FRONTEND_URL=http://localhost:5173

