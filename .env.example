# docker-compose 및 로컬 실행용 환경변수 예시 파일
# 실제 값을 채운 뒤 .env 로 복사해서 사용하세요 (.env 는 git에 커밋되지 않습니다)
#   cp .env.example .env

### Server Profile & Port ###
SPRING_PROFILES_ACTIVE=local
PORT=8080

### PostgreSQL / Database ###
db-name=ssccops_server_db
db-username=dba
db-password=changeme
# 로컬에서 직접 실행 시 사용할 데이터베이스 접속 JDBC URL (docker-compose postgres 연결 시: jdbc:postgresql://localhost:15432/ssccops_server_db)
db-url=jdbc:postgresql://localhost:15432/ssccops_server_db

### Supabase Auth ###
# JWT 검증용 JWKS가 이 URL 기준 /auth/v1/.well-known/jwks.json 에서 조회됩니다
supabase-url=https://xxxxxxxxxxxx.supabase.co

### Frontend ###
# CORS 허용 오리진 (기본값: http://localhost:3000)
frontend-url=http://localhost:4000
