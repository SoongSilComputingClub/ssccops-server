# 로컬 실행용 환경변수 예시 파일
# 실제 값을 채운 뒤 .env 로 복사해서 사용하세요 (.env 는 git에 커밋되지 않습니다)
#   cp .env.example .env
#
# 이 파일 하나를 `docker compose`와 `./gradlew bootRun`이 함께 읽습니다.
#   - docker compose : 이 디렉터리의 .env 를 자동으로 읽습니다
#   - ./gradlew bootRun : build.gradle 이 .env 를 파싱해 JVM 환경변수로 주입합니다
#
# 변수 이름에 하이픈(-)을 쓰지 마세요. Compose의 변수 치환은 셸 문법을 따르기 때문에
# `${db-username}` 은 "db 가 없으면 문자열 username" 이라는 뜻이 되어, .env 값이
# 통째로 무시된 채 엉뚱한 계정으로 DB가 만들어집니다.

### 프로필 · 포트 ###
SPRING_PROFILES_ACTIVE=local
# 백엔드를 호스트에 노출할 포트 (docker compose 로 띄울 때)
PORT=8080

### PostgreSQL ###
DB_NAME=ssccops_server_db
DB_USERNAME=dba
DB_PASSWORD=changeme

# 앱이 접속할 DB 주소입니다. 실행 방식에 따라 보는 곳이 다릅니다.
#   - ./gradlew bootRun  : 호스트에서 도니 아래 값(localhost:15432)을 그대로 씁니다
#   - docker compose up  : backend 컨테이너는 같은 네트워크의 postgres:5432 를 봐야 하므로
#                          docker-compose.yml 이 DB_HOST/DB_PORT 를 덮어씁니다
# DB_PORT 는 compose 가 postgres 를 호스트에 게시하는 포트이기도 해서 둘이 자동으로 맞습니다.
DB_HOST=localhost
DB_PORT=15432

### Supabase Auth ###
# JWT 검증용 JWKS 를 {SUPABASE_URL}/auth/v1/.well-known/jwks.json 에서 조회합니다
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

### Frontend ###
# CORS 허용 오리진. 쉼표로 여러 개를 넣을 수 있습니다 (Cloudflare Workers 프리뷰 도메인 대응)
FRONTEND_URL=http://localhost:3000

### 이 API 자신의 공개 주소 (#208) ###
# 행사 이미지의 영구 읽기 주소를 이 값으로 조립합니다.
#   {APP_PUBLIC_BASE_URL}/public/v1/events/{eventId}/images/{fileName}
# 그 주소가 행사 본문 마크다운에 문자열로 굳으므로, 틀린 값을 넣으면 이미 저장된 본문의
# 이미지 링크가 통째로 깨집니다. 비어 있으면 앱은 뜨지만 이미지 발급 요청이 거절됩니다
# (부팅은 됩니다 — 이 값을 쓰지 않는 기능까지 함께 못 뜨게 하지 않습니다).
# 로컬에서 백엔드가 열리는 주소를 그대로 넣습니다(PORT를 바꿨다면 함께 바꾸세요).
APP_PUBLIC_BASE_URL=http://localhost:8080

### Cloudflare R2 (인증사진·행사 이미지, ssccops#113) ###
# **버킷은 비공개로 둡니다** (#208 · ssccops#156). 학술 출석 인증사진과 행사 이미지가 이 버킷
# 하나를 함께 쓰는데 R2의 공개 접근은 버킷 단위라 접두사로 가를 수 없습니다 — 공개하면 얼굴이
# 찍힌 인증사진이 URL만 알면 열립니다. 둘 다 읽을 때마다 짧은 서명 URL을 발급받습니다.
# R2 대시보드 > Manage R2 API Tokens 에서 발급받은 값을 채우세요.
# 엔드포인트는 서버가 R2_ACCOUNT_ID로 https://<account-id>.r2.cloudflarestorage.com 을
# 직접 조립하므로 따로 넣지 않습니다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ssccops-local


### Gemini — 규정 도우미(RAG)의 채팅·임베딩 모델 (#395 · ssccops#322) ###
# Google AI Studio(https://aistudio.google.com/apikey)의 **무료 키**입니다. GCP 프로젝트도
# 결제 계정도 필요 없습니다 — Vertex AI 가 아니라 Gemini Developer API 를 씁니다.
#
# **비워 둬도 됩니다.** 값이 없으면 Gemini 배선 전체가 서지 않고(부팅 로그에 한 줄 남습니다)
# 나머지 기능은 그대로 돕니다. 규정 도우미를 손볼 때만 채우세요.
#
# 채운 뒤 `./gradlew geminiCheck` 로 실제로 무엇이 나오는지 재 볼 수 있습니다
# (차원 · task-type 이 실리는지 · 정규화 여부 · 긴 조문이 잘리는지).
GEMINI_API_KEY=
# 모델 ID 교체는 환경변수 하나입니다 (기본값: gemini-3.6-flash · gemini-embedding-2).
# 임베딩이 001 이 아니라 2 인 이유는 2026-09-13 실측입니다 — 입력 상한이 2,048 → 8,192 토큰이고
# 768로 잘라도 정규화돼 있습니다(001 은 노름 0.58). application.yaml 의 표에 다 적어 두었습니다.
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

### 회원 하드 삭제 (임시 · #361 · ADR-0021) ###
# 연동 실패로 생긴 중복 계정을 정리하는 동안만 켭니다. 기본값은 false이고 어느 프로필 설정
# 파일에도 이 키가 없습니다 — dev·prod는 Coolify 환경변수로 켭니다. 켜면
# DELETE /v1/members/{mbrId} 와 deletion-preview 가 열리고, 끄면 둘 다 404 FEATURE_DISABLED 입니다.
# SSCCOPS_MEMBER_HARD_DELETE_ENABLED=true

### 규정 도우미(RAG) 기능 플래그 (#396 · Epic ssccops#321) ###
# 질의·적재·색인 워커를 **함께** 엽니다. 기본값은 false이고 어느 프로필 설정 파일에도 이 키가
# 없습니다 — dev·prod는 Coolify 환경변수로 켭니다(회원 하드 삭제와 같은 방식).
#
# 꺼져 있으면 404 ASSISTANT_DISABLED 입니다. 질의만 닫지 않는 이유는 끄는 이유가 대개 임베딩
# 쿼터인데, 워커만 살아 있으면 계속 그것을 태우기 때문입니다.
#
# GEMINI_API_KEY 와는 다른 축입니다 — 키가 없으면 배선 자체가 서지 않아 503 ASSISTANT_UNAVAILABLE
# 이고(설정이 덜 된 상태), 이 플래그는 「이 서버에 규정 도우미가 없다」입니다.
# SSCCOPS_ASSISTANT_ENABLED=true
