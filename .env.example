# docker-compose용 환경변수 예시 파일
# 실제 값을 채운 뒤 .env 로 복사해서 사용하세요 (.env 는 git에 커밋되지 않습니다)
#   cp .env.example .env

### MySQL / Database ###
DB_NAME=database
DB_USER=dba
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

### Google OAuth2 ###
PROD_GOOGLE_CLIENT_NAME=Google
PROD_GOOGLE_CLIENT_ID=your-google-client-id
PROD_GOOGLE_CLIENT_SECRET=your-google-client-secret
PROD_GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

### JWT ###
PROD_JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
PROD_JWT_ACCESS_TOKEN_EXPIRES_IN=3600000
PROD_JWT_REFRESH_TOKEN_EXPIRES_IN=604800000

### Frontend ###
PROD_FRONTEND_URL=http://localhost:5173
