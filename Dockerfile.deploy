# ============================================================================
# Dockerfile for CI/CD Pipeline (Pre-built JAR)
# ============================================================================
# 이 Dockerfile은 CI 파이프라인에서 이미 빌드된 JAR 파일을 사용합니다.
# 로컬 개발 시에는 기존 Dockerfile (멀티스테이지 빌드)을 사용하세요.
# ============================================================================

FROM eclipse-temurin:17-jre

WORKDIR /app

# CI에서 빌드된 JAR 파일 복사
COPY build/libs/*.jar app.jar

EXPOSE 8080

# 힙 상한을 명시해 메타스페이스·스레드 스택·GC 북키핑에 여유를 남긴다(ssccops-server#107).
# 플래그가 없으면 JDK 17 기본값(MaxRAMPercentage=25.0)이 힙만 제한하고 힙 밖 메모리는
# 그대로라, 작은 컨테이너에서 Hibernate가 EntityManagerFactory를 만드는 도중
# (엔티티 26종 메타모델 로딩) OOM으로 죽는다(exit 137). SerialGC는 G1GC보다 북키핑
# 오버헤드가 적어 작은 힙에서의 GC 비용을 줄인다. 로컬용 Dockerfile 과 같은 값이어야
# 한다 — 한쪽만 고치면 로컬에서는 뜨는데 배포에서만 죽는 차이가 생긴다.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=60.0", "-XX:+UseSerialGC", "-Xss512k", "-jar", "app.jar"]
