# docker-compose용 환경변수 예시 파일
# 실제 값을 채운 뒤 .env 로 복사해서 사용하세요 (.env 는 git에 커밋되지 않습니다)
#   cp .env.example .env

### PostgreSQL / Database ###
# application-local.yaml의 ${db-username}, ${db-password}, ${db-url}에 매핑됩니다.
DB_NAME=ssccops_server_db
DB_USERNAME=dba
DB_PASSWORD=changeme
# 로컬에서 직접 실행 시 사용할 데이터베이스 접속 JDBC URL (예: 로컬 PostgreSQL 또는 docker-compose postgres)
DB_URL=jdbc:postgresql://localhost:15432/ssccops_server_db

### Supabase Auth (local 전용 — dev/prod는 배포 환경에 별도로 주입되어 있음) ###
# application-local.yaml의 ${supabase-url}에 매핑됩니다.
# JWT 검증용 JWKS가 이 URL 기준 /auth/v1/.well-known/jwks.json 에서 조회된다
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

### Frontend ###
# CORS 허용 오리진 (기본값: http://localhost:3000, 포트 변경 시 FRONTEND_URL 로 오버라이드 가능)
FRONTEND_URL=http://localhost:4000
PROD_FRONTEND_URL=http://localhost:5173

