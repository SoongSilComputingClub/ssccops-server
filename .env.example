# 로컬 실행용 환경변수 예시 파일
# 실제 값을 채운 뒤 .env 로 복사해서 사용하세요 (.env 는 git에 커밋되지 않습니다)
#   cp .env.example .env
#
# 이 파일 하나를 `docker compose`와 `./gradlew bootRun`이 함께 읽습니다.
#   - docker compose : 이 디렉터리의 .env 를 자동으로 읽습니다
#   - ./gradlew bootRun : build.gradle 이 .env 를 파싱해 JVM 환경변수로 주입합니다
#
# 변수 이름에 하이픈(-)을 쓰지 마세요. Compose의 변수 치환은 셸 문법을 따르기 때문에
# `${db-username}` 은 "db 가 없으면 문자열 username" 이라는 뜻이 되어, .env 값이
# 통째로 무시된 채 엉뚱한 계정으로 DB가 만들어집니다.

### 프로필 · 포트 ###
SPRING_PROFILES_ACTIVE=local
# 백엔드를 호스트에 노출할 포트 (docker compose 로 띄울 때)
PORT=8080

### PostgreSQL ###
DB_NAME=ssccops_server_db
DB_USERNAME=dba
DB_PASSWORD=changeme

# 앱이 접속할 DB 주소입니다. 실행 방식에 따라 보는 곳이 다릅니다.
#   - ./gradlew bootRun  : 호스트에서 도니 아래 값(localhost:15432)을 그대로 씁니다
#   - docker compose up  : backend 컨테이너는 같은 네트워크의 postgres:5432 를 봐야 하므로
#                          docker-compose.yml 이 DB_HOST/DB_PORT 를 덮어씁니다
# DB_PORT 는 compose 가 postgres 를 호스트에 게시하는 포트이기도 해서 둘이 자동으로 맞습니다.
DB_HOST=localhost
DB_PORT=15432

### Supabase Auth ###
# JWT 검증용 JWKS 를 {SUPABASE_URL}/auth/v1/.well-known/jwks.json 에서 조회합니다
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

### Frontend ###
# CORS 허용 오리진. 쉼표로 여러 개를 넣을 수 있습니다 (Cloudflare Workers 프리뷰 도메인 대응)
FRONTEND_URL=http://localhost:3000
